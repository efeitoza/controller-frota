# Copie para .env.local (ou preencha os Secrets no Replit)
# Project Settings > API no painel do Supabase

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Domínio usado para montar o e-mail a partir do login do condutor
# ex.: login "antonio.campos" -> antonio.campos@empresa.com.br
NEXT_PUBLIC_LOGIN_DOMAIN=empresa.com.br

# Sem as variáveis acima o app sobe em MODO DEMONSTRAÇÃO,
# com dados de exemplo na memória do navegador.
